# 複製成 .env 後修改。所有值都有預設，第一次啟動不需要做任何決定。
#
# ⚠️ 不要把變數設成空字串來表示「不啟用」。compose 會把 VAR= 渲染成空字串而不是
# 未設定，而只檢查「有沒有設」的程式碼擋不住空字串——那是這類設定最常見的沉默失敗。
# 不需要某一項時請整行註解掉。

# ── 對外主機名 ────────────────────────────────────────────────────────────
# app（模擬器或實體 iPad）看得到的位址。實機測試時換成 Mac 的 LAN IP。
PUBLIC_HOST=localhost

# ── 連接埠 ────────────────────────────────────────────────────────────────
FHIR_PORT=8080
KEYCLOAK_PORT=8081
# 刻意不是 5432：多數開發機上已經有一個 Postgres 佔著它。
DB_PORT=5433

# ── 資料庫 ────────────────────────────────────────────────────────────────
# 開發用，不是機密。
DB_USER=siming
DB_PASSWORD=siming
DB_NAME=siming_demo

# ── Keycloak ──────────────────────────────────────────────────────────────
# 開發用管理者帳號，不是機密。正式部署必須換掉。
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# app 的回呼位址。必須與 Info.plist 的 CFBundleURLSchemes 一致。
APP_REDIRECT_URI=tideng://smart/callback

# ── Siming 的位置 ─────────────────────────────────────────────────────────
# 預設假設它與 Tideng 平行 clone。路徑不同時在這裡指定。
SIMING_PATH=../../Siming
